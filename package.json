{
  "name": "optionscope",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm --workspace frontend run dev",
    "build": "npm --workspace frontend run build",
    "api": "backend/.venv/bin/uvicorn src.main:app --app-dir backend --reload --port 8000",
    "check": "npm run build && backend/.venv/bin/python -m pytest backend/tests"
  },
  "engines": {
    "node": ">=20"
  }
}
